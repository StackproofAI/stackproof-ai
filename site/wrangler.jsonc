{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site only: no Worker script, no database, no secrets (the lead form was dropped on 2026-11-19).
  "name": "stackproof-ai-site-v2",
  // Set on the day of each deploy (brief §6).
  "compatibility_date": "2026-11-19",
  "assets": {
    // directory is filled in by the Cloudflare Vite plugin from the client build output.
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
