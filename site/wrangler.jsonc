{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stackproof-ai-site-v2",
  "main": "./worker/index.ts",
  // Set on the day of each deploy (brief §6).
  "compatibility_date": "2026-11-19",
  "assets": {
    // directory is filled in by the Cloudflare Vite plugin from the client build output.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },

  // ── Preview environment (default) ──
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stackproof-leads-preview",
      // Filled in when the preview database is created at checkpoint 4 (wrangler d1 create).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [{ "name": "LEAD_RL", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } }],
  "vars": { "TURNSTILE_HOSTNAMES": "stackproof-ai-site-v2.stackproofai.workers.dev" },
  // TURNSTILE_SECRET is a secret: `wrangler secret put TURNSTILE_SECRET` (never in this file).

  "env": {
    "production": {
      "d1_databases": [
        { "binding": "DB", "database_name": "stackproof-leads", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      "ratelimits": [{ "name": "LEAD_RL", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } }],
      "vars": { "TURNSTILE_HOSTNAMES": "stackproof-ai-site-v2.stackproofai.workers.dev" }
    }
  }
}
